# Grouped by what makes the file, so an entry can be judged rather than
# just inherited. Everything here is generated, personal, or both; nothing
# in it should ever be worth committing.

# Python bytecode and build products
*__pycache__*
*.pyc
*.pyo
*.so
*.egg
*.egg-info/
build/
dist/
sdist/
wheels/

# Virtual environments. Scratch environments belong outside the working
# tree; these names are here because they end up inside it anyway, and a
# committed site-packages breaks the build for everyone else -- setuptools
# reads a stray environment directory as a second top-level package.
.venv/
venv/
env/
ENV/

# Tool caches. Each of these is rebuilt on demand and is machine-specific.
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.nox/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Documentation, built and autogenerated. docs/generated/ holds the stubs
# autosummary writes from the docstrings, so it is derived from the source
# rather than part of it.
docs/_build/
docs/generated/

# Rendered audio. The examples write WAV files next to themselves.
*.wav

# The singing engine, cloned on demand by setup_engine()
music/singing/ecantorix/

# Editors and tools
*.swp
*.swo
*.ropeproject
.idea/
.vscode/
ipython_log.py

# Personal agent settings. The shared .claude/settings.json, if there ever
# is one, is deliberately not ignored.
.claude/settings.local.json

# Operating system cruft
.DS_Store
Thumbs.db

# Miscellany kept from earlier versions of this file
*.pickle
musicPacDir/
